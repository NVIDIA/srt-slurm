#!/usr/bin/env bash
# SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
# SPDX-License-Identifier: Apache-2.0
#
# Direct-container shim rendered by `srtctl apply --bash`.
#
# Bash owns only the host/container boundary.  The serialized plan below is
# executed by direct_runner.py, inside the same SGLang environment as the
# workers, which owns installation, processes, readiness, telemetry, cleanup,
# and ruter normalization.

set -Eeuo pipefail

SRTCTL_SOURCE={{ quote(context.source_dir) }}
OUTPUT_BASE={{ quote(context.output_base) }}
SRTCTL_LOCAL_CONTAINER_IMAGE={{ quote(context.local_container_image) }}
SRTCTL_RENDERED_MODEL_PATH={{ quote(context.model_path) }}
SRTCTL_SGLANG_SOURCE={{ quote(context.sglang_source) }}
SRTCTL_SGLANG_RUNTIME_KEY={{ quote(context.sglang_runtime_key) }}
RUN_NAME={{ quote(context.name) }}
SRTCTL_PYTHON="${SRTCTL_PYTHON:-python3}"
OUTPUT_DIR="${SRTCTL_OUTPUT_DIR:-${OUTPUT_BASE}/${RUN_NAME}-$(date -u +%Y%m%dT%H%M%SZ)-$$}"
LOG_DIR="${OUTPUT_DIR}/logs"
ARTIFACT_DIR="${OUTPUT_DIR}/artifacts"
export OUTPUT_DIR LOG_DIR ARTIFACT_DIR SRTCTL_PYTHON
{% if context.mooncake_master_command %}
SRTCTL_MOONCAKE_CONTAINER_NAME=""
SRTCTL_MOONCAKE_LOG_PID=""
{% endif %}

if [[ "${SRTCTL_LOCAL_CONTAINERIZED:-}" != "1" ]]; then
    command -v docker >/dev/null 2>&1 || {
        echo "srtctl: SRTCTL_LOCAL_CONTAINER_IMAGE requires docker" >&2
        exit 1
    }
    SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
    [[ -f "${SCRIPT_PATH}" ]] || {
        echo "srtctl: containerized --bash script must be saved to a file before execution" >&2
        exit 1
    }

    SRTCTL_CONTAINER_NAME="srtctl-direct-$$"
    SRTCTL_CONTAINER_LABEL="io.nvidia.srtctl.direct-output=$(printf '%s' "${OUTPUT_DIR}" | sha256sum | awk '{print $1}')"
    while IFS= read -r stale_container; do
        [[ -z "${stale_container}" ]] || docker rm -f "${stale_container}" >/dev/null 2>&1 || true
    done < <(docker ps -aq --filter "label=${SRTCTL_CONTAINER_LABEL}")

    declare -a SRT_CONTAINER_ARGS=(
        --detach
        --name "${SRTCTL_CONTAINER_NAME}"
        --label "${SRTCTL_CONTAINER_LABEL}"
        --network host
        --ipc host
        --gpus all
        --ulimit memlock=-1
        --ulimit stack=67108864
        --entrypoint bash
        --mount "type=bind,src=${SCRIPT_PATH},dst=/run/srtctl-direct.sh,readonly"
    )
    srt_container_mount() {
        local path="$1"
        local mode="$2"
        [[ -e "${path}" ]] || {
            echo "srtctl: required container mount does not exist: ${path}" >&2
            exit 1
        }
        path="$(readlink -f "${path}")"
        local mount="type=bind,src=${path},dst=${path}"
        if [[ "${mode}" == "readonly" ]]; then
            mount+=",readonly"
        fi
        SRT_CONTAINER_ARGS+=(--mount "${mount}")
    }

    mkdir -p "${OUTPUT_BASE}"
    srt_container_mount "${SRTCTL_SOURCE}" readonly
    srt_container_mount "${OUTPUT_BASE}" rw
    # A Hugging Face snapshot contains relative links into the repository blob
    # store, so mount its repository root when it is available.
    SRTCTL_MODEL_MOUNT_PATH="${SRTCTL_RENDERED_MODEL_PATH}"
    if [[ "$(basename "$(dirname "${SRTCTL_MODEL_MOUNT_PATH}")")" == "snapshots" && -d "$(dirname "$(dirname "${SRTCTL_MODEL_MOUNT_PATH}")")/blobs" ]]; then
        SRTCTL_MODEL_MOUNT_PATH="$(dirname "$(dirname "${SRTCTL_MODEL_MOUNT_PATH}")")"
    fi
    srt_container_mount "${SRTCTL_MODEL_MOUNT_PATH}" readonly

    srt_container_mount "${SRTCTL_SGLANG_SOURCE}" readonly
    SRTCTL_SGLANG_REVISION="$(git -c safe.directory="${SRTCTL_SGLANG_SOURCE}" -C "${SRTCTL_SGLANG_SOURCE}" rev-parse --verify HEAD)" || {
        echo "srtctl: unable to identify SGLang source revision: ${SRTCTL_SGLANG_SOURCE}" >&2
        exit 1
    }
    SRTCTL_SGLANG_RUNTIME_DIR="${OUTPUT_BASE}/.srtctl-runtime/sglang-${SRTCTL_SGLANG_REVISION}-${SRTCTL_SGLANG_RUNTIME_KEY}"
    if [[ -n "${RUTER_MOONCAKE_TRACE:-}" ]]; then
        srt_container_mount "${RUTER_MOONCAKE_TRACE}" readonly
        SRT_CONTAINER_ARGS+=(-e RUTER_MOONCAKE_TRACE)
    fi
    SRTCTL_DYNAMO_CACHE_ROOT="${OUTPUT_BASE}/.srtctl-cache/dynamo-wheels"
    mkdir -p "${SRTCTL_DYNAMO_CACHE_ROOT}"
    srt_container_mount "${SRTCTL_DYNAMO_CACHE_ROOT}" rw

    SRT_CONTAINER_ARGS+=(
        "${SRTCTL_LOCAL_CONTAINER_IMAGE}"
        -lc 'trap "exit 0" TERM INT; while :; do sleep 3600; done'
    )
    srt_restore_owner() {
        local path="$1"
        local owner="$2"
        [[ -e "${path}" ]] || return 0
        chown -R "${owner}" "${path}" 2>/dev/null || sudo -n chown -R "${owner}" "${path}"
    }
    srt_container_cleanup() {
        local rc=$?
        trap - EXIT INT TERM
{% if context.mooncake_master_command %}
        if [[ -n "${SRTCTL_MOONCAKE_LOG_PID}" ]]; then
            kill "${SRTCTL_MOONCAKE_LOG_PID}" 2>/dev/null || true
            wait "${SRTCTL_MOONCAKE_LOG_PID}" 2>/dev/null || true
        fi
        if [[ -n "${SRTCTL_MOONCAKE_CONTAINER_NAME}" ]]; then
            docker logs "${SRTCTL_MOONCAKE_CONTAINER_NAME}" >>"${LOG_DIR}/mooncake-master.log" 2>&1 || true
            docker rm -f "${SRTCTL_MOONCAKE_CONTAINER_NAME}" >/dev/null 2>&1 || true
        fi
{% endif %}
        docker rm -f "${SRTCTL_CONTAINER_NAME}" >/dev/null 2>&1 || true
        local owner
        owner="$(id -u):$(id -g)"
        srt_restore_owner "${OUTPUT_DIR}" "${owner}" || echo "srtctl: failed to restore output ownership: ${OUTPUT_DIR}" >&2
        srt_restore_owner "${SRTCTL_SGLANG_RUNTIME_DIR}" "${owner}" || echo "srtctl: failed to restore SGLang runtime ownership: ${SRTCTL_SGLANG_RUNTIME_DIR}" >&2
        exit "${rc}"
    }
    trap srt_container_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

{% if context.mooncake_master_command %}
    mkdir -p "${LOG_DIR}"
    SRTCTL_MOONCAKE_CONTAINER_NAME="${SRTCTL_CONTAINER_NAME}-mooncake"
    declare -a SRT_MOONCAKE_CONTAINER_ARGS=(
        --detach
        --name "${SRTCTL_MOONCAKE_CONTAINER_NAME}"
        --label "${SRTCTL_CONTAINER_LABEL}"
        --network host
        --ipc host
        --gpus all
        --ulimit memlock=-1
        --ulimit stack=67108864
{% for key, value in context.mooncake_environment %}
        --env {{ quote(key + "=" + value) }}
{% endfor %}
    )
    docker run "${SRT_MOONCAKE_CONTAINER_ARGS[@]}" {{ quote(context.mooncake_container or context.local_container_image or '') }} \
{% for argument in context.mooncake_master_command %}
        {{ quote(argument) }}{% if not loop.last %} \
{% endif %}
{% endfor %}        >"${LOG_DIR}/mooncake-master.container-id"
    docker logs -f "${SRTCTL_MOONCAKE_CONTAINER_NAME}" >"${LOG_DIR}/mooncake-master.log" 2>&1 &
    SRTCTL_MOONCAKE_LOG_PID=$!
{% endif %}

    docker run "${SRT_CONTAINER_ARGS[@]}" >/dev/null
    declare -a SRT_CONTAINER_EXEC_ARGS=(
        -e SRTCTL_LOCAL_CONTAINERIZED=1
        -e "SRTCTL_OUTPUT_DIR=${OUTPUT_DIR}"
        -e "SRTCTL_DYNAMO_CACHE_ROOT=${SRTCTL_DYNAMO_CACHE_ROOT}"
    )
    SRT_CONTAINER_EXEC_ARGS+=(-e "SRTCTL_SGLANG_RUNTIME_DIR=${SRTCTL_SGLANG_RUNTIME_DIR}")
    if [[ -n "${RUTER_MOONCAKE_TRACE:-}" ]]; then
        SRT_CONTAINER_EXEC_ARGS+=(-e "RUTER_MOONCAKE_TRACE=${RUTER_MOONCAKE_TRACE}")
    fi
    docker exec "${SRT_CONTAINER_EXEC_ARGS[@]}" "${SRTCTL_CONTAINER_NAME}" bash /run/srtctl-direct.sh
    exit $?
fi

mkdir -p "${OUTPUT_DIR}"
DIRECT_PLAN="${OUTPUT_DIR}/direct-plan.json"
cat >"${DIRECT_PLAN}" <<{{ direct_plan_marker }}
{{ context.direct_plan_json }}
{{ direct_plan_marker }}
exec "${SRTCTL_PYTHON}" "${SRTCTL_SOURCE}/src/srtctl/render/direct_runner.py" --plan "${DIRECT_PLAN}"
