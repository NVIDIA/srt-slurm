# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM rust:1.90-slim-bookworm AS builder

ARG TARGETARCH

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libssl-dev \
        pkg-config \
    && if [ "$TARGETARCH" = "arm64" ]; then \
        dpkg --add-architecture arm64 \
        && apt-get update \
        && apt-get install -y --no-install-recommends \
            gcc-aarch64-linux-gnu \
            libc6-dev:arm64 \
            libssl-dev:arm64; \
    fi \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src/tachometer/tachometer-writer/Cargo.toml src/tachometer/tachometer-writer/Cargo.toml
COPY src/tachometer/tachometer-scraper/Cargo.toml src/tachometer/tachometer-scraper/Cargo.toml
COPY src/tachometer/tachometer-writer/src src/tachometer/tachometer-writer/src
COPY src/tachometer/tachometer-scraper/src src/tachometer/tachometer-scraper/src

RUN if [ "$TARGETARCH" = "arm64" ]; then rustup target add aarch64-unknown-linux-gnu; fi

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target,id=tachometer-target-$TARGETARCH,sharing=locked \
    if [ "$TARGETARCH" = "arm64" ]; then \
        export CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
        && export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
        && export PKG_CONFIG_ALLOW_CROSS=1 \
        && export PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig \
        && export CFLAGS_aarch64_unknown_linux_gnu="-I/usr/include/aarch64-linux-gnu" \
        && cargo build --release --locked --bin tachometer-scraper --target aarch64-unknown-linux-gnu \
        && cp target/aarch64-unknown-linux-gnu/release/tachometer-scraper /tachometer-scraper; \
    else \
        cargo build --release --locked --bin tachometer-scraper \
        && cp target/release/tachometer-scraper /tachometer-scraper; \
    fi

FROM scratch AS artifact
COPY --from=builder /tachometer-scraper /tachometer-scraper
